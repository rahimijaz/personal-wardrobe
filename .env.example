# ==================================================================
# Fitcheck Wardrobe Studio — Environment Configuration
# Copy this file to .env to customize settings.
# No cloud keys or databases are required for the default local setup.
# ==================================================================

# ------------------------------------------------------------------
# Virtual Try-On Service (FASHN-VTON with DirectML)
# ------------------------------------------------------------------

# URL of the local Python VTON server (started via start.bat or python vton-service/server.py)
VTON_SERVICE_URL=http://127.0.0.1:8188

# Master switch for local try-on features
VTON_ENABLED=true

# How long Next.js waits for try-on generation polling before timing out (in ms)
# Default: 1200000 (20 minutes, safely accommodating multi-pass DirectML Euler steps)
VTON_TIMEOUT_MS=1200000

# ------------------------------------------------------------------
# Python VTON Service Settings (read by vton-service/fashn_runner.py)
# ------------------------------------------------------------------

# Acceleration device: directml (AMD Radeon / Intel GPUs), cuda (NVIDIA), or cpu
FASHN_DEVICE=directml

# Path to the FASHN-VTON model weights directory
# Default looks for ./FASHN-VTON/weights containing model.safetensors and dwpose ONNX
FASHN_WEIGHTS_DIR=FASHN-VTON/weights

# Default diffusion timesteps (8-12 recommended for fast Euler sampling on DirectML)
FASHN_TIMESTEPS=8

# Classifier-Free Guidance scale (default: 2.0)
FASHN_GUIDANCE=2.0

# Number of CFG steps to skip at the end for faster convergence
FASHN_SKIP_CFG=5

# Seed for reproducible generations
FASHN_SEED=42

# ------------------------------------------------------------------
# Legacy / Optional Database
# (The active application uses local JSON storage at data/wardrobe.json)
# ------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ------------------------------------------------------------------
# Optional Cloud Providers (Only needed if NOT running local VTON)
# ------------------------------------------------------------------
# FAL_KEY=
# GEMINI_API_KEY=
